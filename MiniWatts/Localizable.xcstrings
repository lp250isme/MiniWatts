    "Select at least one item to display." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少选择一项显示内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
